public class Prueba4{
    
    public  String orugas(int faseDeCrecimiento, String patronBase){
        String res = patronBase;
        String oruga;
        if(faseDeCrecimiento >= 1){
            oruga = añadirColores(patronBase,0);
            res = orugas(faseDeCrecimiento-1, oruga);
        }
        return res;
    }
    
    private String añadirColores(String patronBase, int i){
        String res = "C";
        char caracter = patronBase.charAt(i);
        if(i < patronBase.length()-1){
            if(caracter == 'N'){
                res = caracter +'A'+añadirColores(patronBase, i+1);
            }else{
                res = caracter + 'N'+ añadirColores(patronBase, i+1);
            }
        }
        return res;
    }
}
